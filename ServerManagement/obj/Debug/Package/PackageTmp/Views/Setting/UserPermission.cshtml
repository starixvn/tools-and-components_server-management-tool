@{
    ViewBag.Title = "UserPermission";
    Layout = null;
    var sites = Model.Sites;         
    
}
@model ServerManagement.Models.UserSiteViewModel
<br />
<div class="header-action input-control select">
    @Html.DropDownListFor(model => model.SiteId, new SelectList(sites, "SiteId", "SiteName"))
</div>
<div class="container">
    <table>
        <thead>
            <tr>
                <th>
                    Username
                </th>
                <th class="col-edit">
                    No Access
                </th>
                <th class="col-edit">
                    View
                </th>
                <th class="col-edit">
                    Admin
                </th>
            </tr>
        </thead>
        <tbody>
            @Html.Partial("UserPermissionView", Model)
        </tbody>
    </table>
</div>
