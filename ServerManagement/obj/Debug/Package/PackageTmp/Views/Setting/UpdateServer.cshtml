@{
    ViewBag.Title = "UpdateServer";
    Layout = null;
}
@model ServerManagement.Models.ServerModel
<form>
<div class="input-control modern text iconic">
    <input class="full-size" type="text" name="ServerIp" id="ServerIp" value="@Model.ServerIp" />
    <span class="caption">Server IP</span>
</div>
<div class="input-control modern iconic">
    <input class="full-size" type="text" name="ServerName" id="ServerName" value="@Model.ServerName"  />
    <span class="caption">Server Name</span>
</div>
<br />
<br />
<div class="form-actions">
    <button id="btn-submit" type="button" class="button small-button primary">
        Submit</button>
    <button id="btn-cancel" type="button" class="button small-button primary">
        Cancel</button>
</div>

<input type="hidden" name="ServerId" id="ServerId" value="@Model.ServerId" />
</form>
