@{
    ViewBag.Title = "ServiceListView";
    Layout = null;
}
@model List<ServerManagement.Models.ServiceManagementModel>
@foreach (var item in Model)
{
    <tr class="@(item.Status == 1 ? "bg-darkRed" : "")">
        
        <td>
            @item.ServiceName
        </td>
        <td>
            @(item.Status == 1 ? "Stopped" : "Running")
        </td>
        <td>
            @item.SiteName
        </td>
        <td>
            @item.ServerIp
        </td>
        
    </tr>
}
