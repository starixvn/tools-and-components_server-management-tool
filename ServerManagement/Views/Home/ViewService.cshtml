@{
    ViewBag.Title = "ViewService";
    Layout = null;
    var serverId = ViewBag.ServerId;
}
@model List<ServerManagement.Models.ServiceManagementModel>
<table class="table">
    <thead>
        <tr>
            <th>
                Service Name
            </th>
            <th>
                Display Name
            </th>
            <th>
                Status
            </th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Count > 0)
        {
            foreach (var service in Model)
            {
            <tr class="bg-darkBlue fg-white">
                <td>@service.ServiceName
                </td>
                <td>@service.DisplayName
                </td>
                <td>
                    <span id="service-@service.Id" class="action-service" data-service-id="@service.Id" data-service-status="@service.Status" data-service-name="@service.ServiceName" data-server-id="@serverId">
                        @(service.Status == 1 ? "Stopped" : "Running")
                    </span>
                </td>
            </tr>            
            }
        }
        else
        { 
    
            <tr>
                <td colspan="3">
                    There is no information!!!
                </td>
            </tr>
        }
    </tbody>
</table>
