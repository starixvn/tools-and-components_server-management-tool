@{
    ViewBag.Title = "Index";
}
@model List<ServerManagement.Models.MachinesViewModel>
@section scripts{
    <script type="text/ecmascript">
        $(document).ready(function () {            
            SITE.initialize();            
        });
    </script>
}

    @foreach (var machine in Model)
    {
        <div class="tile-group triple">
            <span class="tile-group-title">@machine.System</span>
            <div class="tile-container">
                @foreach (var reply in machine.ReplyServer)
                {
                    var backgroup = "bg-transparent";
                    if (!reply.IsFail)
                    {
                        backgroup = "bg-red";
                    }
                
                    <div id="server-@reply.ServerId" name="server" site-id="@machine.Id" server-id="@reply.ServerId" class="tile @backgroup fg-white" data-role="tile">
                        <div class="tile-content iconic slide-down">
                            <span id="icon-@reply.ServerSiteId" class="icon mif-display server-icon"></span>
                            <div class="slide-over bg-green text-small padding10">
                                <div class="tile-menu select-server" server-id="@reply.ServerId">
                                    Select Server
                                </div>
                                <div class="tile-menu view-spec" server-id="@reply.ServerId">
                                    Specification
                                </div>
                                 <div class="tile-menu view-service" server-id="@reply.ServerId" site-id="@machine.Id">
                                    Services
                                </div>
                                <div class="tile-menu view-iis" server-id="@reply.ServerId">
                                    IIS
                                </div>
                            </div>
                        </div>
                        <span class="tile-label">
                            <p id="server-name-@reply.ServerId" class="tertiary-text fg-white no-margin">@reply.ServerIp</p>
                            <p id="time-@reply.ServerId" class="tertiary-text fg-lime no-margin">@Convert.ToDateTime(reply.ReplyTime).ToShortTimeString()</p>
                        </span>
                    </div>
                }
            </div>
        </div>
    }
</div>
