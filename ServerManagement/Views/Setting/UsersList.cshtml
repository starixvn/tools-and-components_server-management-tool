@model List<ServerManagement.Models.UserModel>
@{
    ViewBag.Title = "User List";
    Layout = null;
}
<div class="header-action">
    <button id="btn-add" class="button small-button primary">
        Add User</button>
</div>
<table>
    <thead>
        <tr>
            <th class="col-id">
                Id
            </th>
            <th>
                Username
            </th>
            <th>
                Password
            </th>
              <th>
                Email
            </th>
            <th class="col-edit">
                Edit
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td class="text-align-center">
                    @user.UserId                    
                </td>
                <td>
                    @user.Username
                </td>
                <td>
                    @user.Password
                </td>
                   <td>
                    @user.Email 
                </td>
                <td class="text-align-center">
                    <span class="mif-pencil icon-edit" user-id="@user.UserId"></span>
                </td>
            </tr>
        }
    </tbody>
</table>
