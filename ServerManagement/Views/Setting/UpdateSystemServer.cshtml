@model ServerManagement.Models.UpdateServerSiteViewModel

@{
    ViewBag.Title = "Update Site Server";
    Layout = null;
    var sites = Model.Sites;
    var servers = Model.Servers;
}

<form>
<br />
<div class="input-control select">
    <span class="label">Site</span>
        @Html.DropDownListFor(model => model.SiteId, new SelectList(sites, "SiteId", "SiteName"))    
</div>

<div class="input-control select">
<span class="label">Server</span>
        @Html.DropDownListFor(model => model.ServerId, new SelectList(servers, "ServerId", "ServerIP"))
</div>
<br />
<br />
<div class="form-actions">
    <button id="btn-submit" type="button" class="button small-button primary">
        Submit</button>
    <button id="btn-cancel" type="button" class="button small-button primary">
        Cancel</button>
</div>
<input type="hidden" name="ServerId" id="ServerId" value="" />
</form>
