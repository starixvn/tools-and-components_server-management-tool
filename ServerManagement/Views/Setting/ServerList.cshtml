@model List<ServerManagement.Models.ServerModel>
@{
    ViewBag.Title = "ServerList";
    Layout = null;
}
<div class="header-action">
    <button id="btn-add" class="button small-button primary">
        Add Server</button>
</div>
<table>
    <thead>
        <tr>
            <th class="col-id">
                Id
            </th>
            <th>
                Ip
            </th>
            <th>
                Server Name
            </th>
            <th class="col-edit">
                Edit
            </th>
            <th class="col-edit">
                Spec
            </th>           
        </tr>
    </thead>
    <tbody>
        @foreach (var server in Model)
        {
            <tr>
                <td class="text-align-center">
                    @server.ServerId                    
                </td>
                <td>
                    @server.ServerIp
                </td>
                <td>
                    @server.ServerName
                </td>
                <td class="text-align-center">
                    <span class="mif-pencil icon-edit" server-id="@server.ServerId"></span>
                </td>
                <td class="text-align-center">
                    <span class="mif-file-download icon-update spec" server-id="@server.ServerId"></span>
                </td>                
            </tr>
        }
    </tbody>
</table>
